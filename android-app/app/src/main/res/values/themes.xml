<resources>
    <style name="Theme.Tyvon" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/tyvon_black</item>
        <item name="android:navigationBarColor">@color/tyvon_black</item>
        <item name="android:windowBackground">@color/tyvon_black</item>
        <item name="android:colorAccent">@color/tyvon_white</item>
    </style>
    <style name="Theme.Tyvon.Starting" parent="Theme.Tyvon">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
