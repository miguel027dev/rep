<resources>
    <style name="Theme.REP" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/rep_black</item>
        <item name="android:navigationBarColor">@color/rep_black</item>
        <item name="android:windowBackground">@color/rep_black</item>
        <item name="android:colorAccent">@color/rep_white</item>
    </style>
    <style name="Theme.REP.Starting" parent="Theme.REP">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
